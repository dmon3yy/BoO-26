; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ballad of Orpheus"
config/description="A spiritual successor to The Battle of Olympus, sung in an industrial underworld."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Events="*res://game/autoload/events.gd"
Settings="*res://game/autoload/settings.gd"
GameState="*res://game/autoload/game_state.gd"
Save="*res://game/autoload/save.gd"
Music="*res://game/autoload/music.gd"
Sfx="*res://game/autoload/sfx.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/gut/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://content/dialogue/zeus.dialogue", "res://content/dialogue/hermes.dialogue", "res://content/dialogue/eurydice.dialogue")

[physics]

common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)
2d/snap/snap_2d_transforms_to_pixel=true
