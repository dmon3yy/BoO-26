{
  "_help": [
    "A rig is a skeleton of pixel parts. Each part has a pivot (the pixel it rotates around),",
    "a parent, and the point on the parent where it attaches. Angles are degrees; positive",
    "angles swing a hanging part BACKWARD (to the left, since Orpheus faces right).",
    "Animations are cycles: angle = mean + amp * sin(2*pi*(harmonic*t + phase)), t in 0..1.",
    "Try it: raise run.uarm_f.amp to swing the arms harder, then run tools/build_character.py."
  ],
  "sprite": "orpheus",
  "palette": "orpheus",
  "frame": [32, 48],
  "hip": [15, 29],
  "parts": {
    "cape":    {"grid": "cape",  "pivot": [3, 0], "parent": "torso",  "attach": [2, 1]},
    "lyre":    {"grid": "lyre",  "pivot": [3, 0], "parent": "torso",  "attach": [2, 3]},
    "uarm_b":  {"grid": "uarm",  "pivot": [2, 1], "parent": "torso",  "attach": [3, 2], "shade": 0.7},
    "farm_b":  {"grid": "farm",  "pivot": [1, 0], "parent": "uarm_b", "attach": [2, 6], "shade": 0.7},
    "thigh_b": {"grid": "thigh", "pivot": [2, 1], "parent": "hip",                      "shade": 0.7},
    "shin_b":  {"grid": "shin",  "pivot": [2, 0], "parent": "thigh_b","attach": [2, 7], "shade": 0.7},
    "thigh_f": {"grid": "thigh", "pivot": [2, 1], "parent": "hip"},
    "shin_f":  {"grid": "shin",  "pivot": [2, 0], "parent": "thigh_f","attach": [2, 7]},
    "torso":   {"grid": "torso", "pivot": [5, 8], "parent": "hip"},
    "head":    {"grid": "head",  "pivot": [5, 9], "parent": "torso",  "attach": [5, 0]},
    "uarm_f":  {"grid": "uarm",  "pivot": [2, 1], "parent": "torso",  "attach": [6, 2]},
    "farm_f":  {"grid": "farm",  "pivot": [1, 0], "parent": "uarm_f", "attach": [2, 6]}
  },
  "draw_order": ["cape", "lyre", "uarm_b", "farm_b", "thigh_b", "shin_b", "thigh_f", "shin_f",
                 "torso", "head", "uarm_f", "farm_f"],
